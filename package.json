{
  "name": "uniapply",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix view",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix view",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
